# Docker Compose local development. Values below are identifiers or ports, not secrets.
APP_PORT=8081
POSTGRES_PORT=5431
POSTGRES_DB=wally
POSTGRES_USER=wally
PSIU_BASE_URL=http://psiu.local
AWS_REGION=us-east-1
AWS_PROFILE=wallyanalyzer
# ARN of an AWS Secrets Manager JSON secret containing username and password.
# Example: arn:aws:secretsmanager:us-east-1:123456789012:secret:wally-local-postgres-xxxxxx
DATABASE_SECRET_ARN=
