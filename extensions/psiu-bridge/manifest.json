{
  "manifest_version": 3,
  "name": "Wally PSIU Bridge",
  "version": "0.1.0",
  "description": "Connects Wally Analyzer to an assigned local PSIU.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": [],
  "host_permissions": ["http://psiu.local/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://wally-analytics.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
