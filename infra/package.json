{
  "name": "@wally/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "synth": "cdk synth -c environment=production && node scripts/assert-smoke-workflow.mjs",
    "deploy:production": "cdk deploy WallyPlatform-production -c environment=production --require-approval broadening",
    "test:smoke-workflow": "node scripts/assert-smoke-workflow.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.197.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.5",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "aws-cdk": "^2.1019.2",
    "tsx": "^4.19.4"
  }
}
